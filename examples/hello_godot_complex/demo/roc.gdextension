[configuration]
entry_symbol = "roc_godot_library_init"
compatibility_minimum = "4.5"
reloadable = true

[icons]
MyPlayerCharacter = "res://roc.svg"
# TODO: implement icons in the "class" script file, not here.

[libraries]
linux.debug.x86_64   = "res://bin/libgodot_roc.so"
linux.release.x86_64 = "res://bin/libgodot_roc.so"
macos.debug          = "res://bin/libgodot_roc.dylib"
macos.release        = "res://bin/libgodot_roc.dylib"
windows.debug.x86_64 = "res://bin/libgodot_roc.dll"
windows.release.x86_64 = "res://bin/libgodot_roc.dll"
web.debug.wasm32 = "res://bin/libgodot_roc.wasm"
web.release.wasm32 = "res://bin/libgodot_roc.wasm"
